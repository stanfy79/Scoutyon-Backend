# Server
PORT=
NODE_ENV=development
CORS_ORIGINS=

# MongoDB Atlas
MONGODB_URI=

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=
# Base64-encoded PKCS#8 P-256 private key, without PEM headers.
# Generate once, register only the public key in Privy Dashboard, and keep this private value server-side.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_KEY_QUORUM_ID=
PRIVY_TRANSFER_POLICY_ID=
# Verified Base token contract -> maximum per-transaction amount in atomic units.
# The Privy policy and server both enforce these caps. This example caps Base USDC at 5 USDC.
PRIVY_BASE_TOKEN_LIMITS={"0x833589fcd6edb6e08f4c7c32d4f71b54bda02913":"5000000"}

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# NEAR Intents 1Click API
NEAR_INTENTS_API_URL=https://1click.chaindefuser.com
NEAR_INTENTS_JWT=

# Live payments remain disabled until a signer, token, network, and merchant
# payment profile have all been configured and reviewed.
# The wallet owner must explicitly authorize the app's signer; readiness never attaches it.
PAYMENTS_LIVE_ENABLED=false
SIMULATE_PAYMENTS=true
PAYMENT_SOURCE_ASSET_ID=
# 1Click is a production API and does not provide a testnet. Must match live token metadata.
# Configured EVM mappings currently allow eth, arb, and base.
PAYMENT_SOURCE_BLOCKCHAIN=
PAYMENT_SOURCE_CHAIN_ID=
PAYMENT_SOURCE_RPC_URL=
PAYMENT_SOURCE_TOKEN_ADDRESS=
# Optional JSON map of EVM chain IDs to public RPC URLs for general swap sources, e.g. {"1":"https://...","8453":"https://..."}.
SWAP_EVM_RPC_URLS={}
PAYMENT_SLIPPAGE_BPS=
PAYMENT_TOKEN_CACHE_TTL_SECONDS=

# Optional read-only parameters for npm run near-intents:diagnose. Never submits transfers.
NEAR_INTENTS_DIAGNOSTIC_PRIVY_WALLET_ID=
NEAR_INTENTS_DIAGNOSTIC_WALLET_ADDRESS=
NEAR_INTENTS_DIAGNOSTIC_PRIVY_USER_ID=
NEAR_INTENTS_DIAGNOSTIC_SOURCE_ASSET=
NEAR_INTENTS_DIAGNOSTIC_SOURCE_NETWORK=
NEAR_INTENTS_DIAGNOSTIC_DESTINATION_ASSET=
NEAR_INTENTS_DIAGNOSTIC_DESTINATION_NETWORK=
NEAR_INTENTS_DIAGNOSTIC_AMOUNT=
NEAR_INTENTS_DIAGNOSTIC_RECIPIENT_ADDRESS=
NEAR_INTENTS_DIAGNOSTIC_REFUND_ADDRESS=
