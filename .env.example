# Server
PORT=5001
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scoutyon?retryWrites=true&w=majority

# Auth - generate a strong random string (min 16 chars)
API_SECRET_KEY=your-strong-secret-key-min-16-chars

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# NEAR (testnet for now)
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# Set to true to use simulated NEAR Intents transactions
SIMULATE_PAYMENTS=true
