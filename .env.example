# Server
PORT=
NODE_ENV=development
CORS_ORIGINS=

# MongoDB Atlas
MONGODB_URI=

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=
# Base64-encoded PKCS8 P-256 private key, without PEM headers
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_KEY_QUORUM_ID=
PRIVY_TRANSFER_POLICY_ID=

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# NEAR Intents 1Click API
NEAR_INTENTS_API_URL=
NEAR_INTENTS_JWT=

# Live payments remain disabled until a signer, token, network, and merchant
# payment profile have all been configured and reviewed.
# The wallet owner must explicitly authorize the app's signer; readiness never attaches it.
PAYMENTS_LIVE_ENABLED=false
SIMULATE_PAYMENTS=true
PAYMENT_SOURCE_ASSET_ID=
# Must match NEAR token metadata; configured EVM mappings currently allow eth, arb, and base
PAYMENT_SOURCE_BLOCKCHAIN=
PAYMENT_SOURCE_CHAIN_ID=
PAYMENT_SOURCE_RPC_URL=
PAYMENT_SOURCE_TOKEN_ADDRESS=
PAYMENT_SLIPPAGE_BPS=
PAYMENT_TOKEN_CACHE_TTL_SECONDS=
